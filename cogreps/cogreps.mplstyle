# Repo-wide matplotlib style for cognitive-task-representations.
# Based on ~/Documents/transfer/fig_gen/panels/transfer.mplstyle so figures
# match the transfer project. Apply with cogreps.plotting.use_style().

# Font: matplotlib default (DejaVu Sans)
# Font sizes: large axis labels (not bold) and tick labels
font.size:          14
axes.labelsize:     22
axes.labelweight:   normal
axes.titlesize:     14
xtick.labelsize:    18
ytick.labelsize:    18
legend.fontsize:    14
figure.titlesize:   18

# No top or right spines
axes.spines.top:    False
axes.spines.right:  False
axes.linewidth:     1.3
xtick.major.size:   6
ytick.major.size:   6
xtick.major.width:  1.2
ytick.major.width:  1.2

# No borders on bars and patches
patch.linewidth:        0
patch.force_edgecolor:  False

# Lines
lines.linewidth:    2.0

# Legends without frames
legend.frameon:     False

# White backgrounds
figure.facecolor:   white
axes.facecolor:     white
savefig.facecolor:  white

# Output
figure.dpi:         100
savefig.dpi:        150
savefig.bbox:       tight
pdf.fonttype:       42
ps.fonttype:        42
